<Window x:Class="TTXView.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTX View"
        Icon="Assets/AppIcon.ico"
        Width="330"
        Height="430"
        MinWidth="280"
        MinHeight="220"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        Background="Transparent"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#36FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder"
            CornerRadius="18"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="添加标的" Click="AddSymbol_Click" />
                <MenuItem Header="新增分类" Click="AddCategory_Click" />
                <MenuItem Header="删除分类" Click="DeleteCategory_Click" />
                <MenuItem Header="删除选中" Click="RemoveSelected_Click" />
                <Separator />
                <MenuItem Header="刷新" Click="Refresh_Click" />
                <MenuItem Header="刷新时间">
                    <MenuItem Header="1s" Tag="1" Click="SetRefreshSeconds_Click" />
                    <MenuItem Header="3s" Tag="3" Click="SetRefreshSeconds_Click" />
                    <MenuItem Header="5s" Tag="5" Click="SetRefreshSeconds_Click" />
                    <MenuItem Header="10s" Tag="10" Click="SetRefreshSeconds_Click" />
                </MenuItem>
                <MenuItem Header="切换主题" Click="ThemeButton_Click" />
                <Separator />
                <MenuItem Header="退出" Click="Close_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="32" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Background="Transparent"
                  PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="#7DD37D" Margin="0,0,7,0" />
                    <TextBlock x:Name="TitleText"
                               Text="TTX View"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Button x:Name="ThemeButton" Content="☾" Width="28" Height="24" Click="ThemeButton_Click" />
                    <Button x:Name="TopmostButton" Width="28" Height="24" Click="TopmostButton_Click">
                        <Viewbox Width="15" Height="15" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="2.75"
                                         Canvas.Top="2.75"
                                         Width="18.5"
                                         Height="18.5"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                         StrokeThickness="2.2" />
                                <Line X1="8.25"
                                      Y1="7.2"
                                      X2="15.75"
                                      Y2="7.2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="2.35"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Path Data="M 12 17.1 L 12 10.1 M 8.45 13.65 L 12 10.1 L 15.55 13.65"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="2.35"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Content="−" Width="28" Height="24" Click="Minimize_Click" />
                    <Button Content="×" Width="28" Height="24" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Border x:Name="SearchBorder"
                    Grid.Row="1"
                    Margin="12,0,12,4"
                    CornerRadius="12"
                    BorderThickness="1"
                    Padding="9,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="13"
                             FontWeight="Bold"
                             VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="输入股票名称或代码，按 Enter 添加到默认分类" />
                    <TextBlock x:Name="SearchHintText"
                               Text="输入股票名称/代码，Enter 添加"
                               FontSize="12"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <Button x:Name="SearchAddButton"
                            Grid.Column="1"
                            Content="+"
                            Width="28"
                            Height="24"
                            Click="SearchAdd_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="12,0,12,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" />
                <TextBlock x:Name="ClockText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" />
            </Grid>

            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8,0,8,5">
                <StackPanel x:Name="CategoriesPanel" />
            </ScrollViewer>

            <Grid Grid.Row="4" Margin="10,0,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OpacityText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="Bold" />
                <Slider x:Name="OpacitySlider"
                        Grid.Column="1"
                        Minimum="35"
                        Maximum="100"
                        Margin="0,0,8,0"
                        ValueChanged="OpacitySlider_ValueChanged"
                        VerticalAlignment="Center" />
            </Grid>

            <Border x:Name="ResizeHandle"
                    Grid.Row="4"
                    Width="30"
                    Height="28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="SizeNWSE"
                    ToolTip="拖动调整大小"
                    PreviewMouseLeftButtonDown="ResizeHandle_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="ResizeHandle_PreviewMouseLeftButtonUp"
                    MouseMove="ResizeHandle_MouseMove">
                <Viewbox Width="15"
                         Height="15"
                         Margin="0,0,8,6"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         IsHitTestVisible="False"
                         Opacity="0.82">
                    <Canvas Width="16" Height="16">
                        <Path x:Name="ResizeGlyph"
                              Data="M 14 4 L 4 14 M 14 8 L 8 14 M 14 12 L 12 14"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Border>
        </Grid>
    </Border>
</Window>
