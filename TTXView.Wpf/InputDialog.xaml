<Window x:Class="TTXView.Wpf.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="340"
        Height="188"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F8FAFC"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#3AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder"
            CornerRadius="18"
            BorderBrush="#405D728A"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F016202B" Offset="0" />
                <GradientStop Color="#F0091019" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar"
                  Background="Transparent"
                  PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="#7DD37D" Margin="0,0,8,0" />
                    <TextBlock x:Name="DialogTitleText"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="×"
                        Width="28"
                        Height="24"
                        Margin="0,0,10,0"
                        Click="Cancel_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="18,4,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PromptText"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#D7E2EF"
                           Margin="0,0,0,9" />

                <Border Grid.Row="1"
                        Height="38"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#4F7DB7F4"
                        Background="#243042">
                    <TextBox x:Name="ValueBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#F8FAFC"
                             CaretBrush="#F8FAFC"
                             SelectionBrush="#6CB6FF"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Padding="10,0"
                             VerticalContentAlignment="Center" />
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="18,0,18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="取消"
                            Width="78"
                            Height="30"
                            Margin="0,0,9,0"
                            IsCancel="True"
                            Background="#18FFFFFF"
                            BorderBrush="#2AFFFFFF"
                            BorderThickness="1"
                            Click="Cancel_Click" />
                    <Button Content="确定"
                            Width="78"
                            Height="30"
                            IsDefault="True"
                            Background="#6CB6FF"
                            Foreground="#07111F"
                            Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
